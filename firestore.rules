rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function getEmail() {
      return request.auth.token.get('email', '').lower();
    }

    // --- Owner Level Access (CRITICAL) ---
    // This allows the owner to read/write EVERYTHING under their own path and subcollections.
    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;

      match /{allPaths=**} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    // --- Invitations (Shared Inbox) ---
    match /invitations/{inviteId} {
      allow create: if isSignedIn();
      allow read, update, delete: if isSignedIn() && (
        resource.data.get('senderId', '') == request.auth.uid ||
        resource.data.get('recipientEmail', '').lower() == getEmail()
      );
    }

    // --- Global Shared File Access ---
    // Allows reading files shared with you or public files from other users.
    match /{path=**}/user_files/{fileId} {
      allow read: if isSignedIn() && (
        getEmail() in resource.data.get('sharedWithEmails', []) ||
        resource.data.get('isPublic', false) == true ||
        resource.data.get('isPubliclyShared', false) == true
      );
    }

    // --- Final Security Guard ---
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
