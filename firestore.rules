rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function getEmail() {
      return request.auth.token.get('email', '').lower();
    }

    // --- User Data ---
    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;

      match /user_files/{fileId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;

        // 🚨 CRITICAL: Allow invited users to add themselves to the file
        // This is required for the 'Accept Invitation' flow to work.
        allow update: if isSignedIn() && (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sharedWith', 'sharedWithEmails'])
        );

        // Allow reading if shared or public
        allow read: if isSignedIn() && (
          getEmail() in resource.data.get('sharedWithEmails', []) ||
          resource.data.get('isPublic', false) == true ||
          resource.data.get('isPubliclyShared', false) == true
        );
      }

      // Activities, Trash & Devices (Owner Only)
      match /activities/{id} { allow read, write: if isSignedIn() && request.auth.uid == userId; }
      match /trash_files/{id} { allow read, write: if isSignedIn() && request.auth.uid == userId; }
      match /devices/{id} { allow read, write: if isSignedIn() && request.auth.uid == userId; }
    }

    // --- Invitations (Shared Inbox) ---
    match /invitations/{inviteId} {
      allow create: if isSignedIn() && request.resource.data.senderId == request.auth.uid;
      allow read, update, delete: if isSignedIn() && (
        resource.data.get('senderId', '') == request.auth.uid ||
        resource.data.get('recipientEmail', '').lower() == getEmail()
      );
    }

    // --- Global Shared File Access (Collection Group) ---
    match /{path=**}/user_files/{fileId} {
      allow read: if isSignedIn() && (
        getEmail() in resource.data.get('sharedWithEmails', []) ||
        resource.data.get('isPublic', false) == true ||
        resource.data.get('isPubliclyShared', false) == true
      );
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
